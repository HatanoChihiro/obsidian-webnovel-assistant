{
	"name": "web-novel-assistant",
	"version": "3.6.3",
	"description": "Obsidian plugin for novel and story writing — accurate word count, goal tracking, story timeline, foreshadowing manager, chapter corkboard, and lore graphs",
	"main": "main.js",
	"scripts": {
		"dev": "esbuild main.ts --bundle --format=cjs --external:obsidian --external:@codemirror/* --outfile=main.js --watch",
		"prebuild": "npm run lint",
		"build": "esbuild main.ts --bundle --format=cjs --external:obsidian --external:@codemirror/* --minify --outfile=main.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src/ main.ts && npx tsx scripts/obsidian-audit.ts"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"writing",
		"word-count",
		"chinese",
		"web-novel",
		"productivity",
		"timer",
		"obs",
		"streaming"
	],
	"author": "HatanoChihiro",
	"license": "MIT",
	"type": "commonjs",
	"repository": {
		"type": "git",
		"url": "https://github.com/HatanoChihiro/obsidian-webnovel-assistant.git"
	},
	"devDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.0",
		"@types/d3-force": "^3.0.10",
		"@types/node": "^26.1.1",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"@vitest/coverage-v8": "^3.2.7",
		"clean-css": "^5.3.3",
		"clean-css-cli": "^5.6.3",
		"cross-env": "^10.1.0",
		"esbuild": "^0.28.0",
		"eslint": "^9.0.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "^1.12.3",
		"ts-morph": "^28.0.0",
		"tslib": "^2.8.1",
		"typescript": "^6.0.2",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"d3-force": "^3.0.0",
		"monkey-around": "^3.0.0"
	}
}
