{
  "name": "web-novel-assistant",
  "version": "3.0.1",
  "description": "Obsidian plugin for web novel writing — accurate word count, goal tracking, focus/slack timer, sticky notes, OBS integration, history stats",
  "main": "main.js",
  "scripts": {
    "dev": "esbuild main.ts --bundle --format=cjs --external:obsidian --external:@codemirror/* --outfile=main.js --watch",
    "build": "esbuild main.ts --bundle --format=cjs --external:obsidian --external:@codemirror/* --minify --outfile=main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ main.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "writing",
    "word-count",
    "chinese",
    "web-novel",
    "productivity",
    "timer",
    "obs",
    "streaming"
  ],
  "author": "HatanoChihiro",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/HatanoChihiro/obsidian-webnovel-assistant.git"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "obsidian": "^1.12.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "vitest": "^3.0.0"
  }
}